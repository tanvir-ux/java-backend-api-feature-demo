# Example MySQL datasource for this demo.
# Copy to application-mysql.yml (gitignored if you prefer) or paste under the mysql profile,
# then run: ./mvnw spring-boot:run -Dspring-boot.run.profiles=mysql
#
# Default local runs stay on H2 — no MySQL required to try the API.

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/feature_demo?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
    driver-class-name: com.mysql.cj.jdbc.Driver
    username: root
    password: your-mysql-password
  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
    properties:
      hibernate:
        dialect: org.hibernate.dialect.MySQLDialect
        format_sql: true
